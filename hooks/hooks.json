{
  "description": "SessionStart routing policy injection; optional stop-time Gemini review gate (off by default; toggle with /gemini-companion:setup --gate on).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/print-routing-policy.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
